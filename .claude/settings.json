{
  "permissions": {
    "allow": [
      "mcp__research-drafter__research_snapshots",
      "mcp__research-drafter__research_snapshot_read",
      "mcp__research-drafter__research_submit_draft",
      "mcp__research-drafter__research_show"
    ],
    "deny": [
      "Bash",
      "PowerShell",
      "Monitor",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Task",
      "Workflow",
      "Skill",
      "ToolSearch",
      "SendMessage",
      "ListAgents",
      "RemoteTrigger",
      "CronCreate",
      "CronDelete",
      "CronList",
      "PushNotification",
      "SendUserFile",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "EnterWorktree",
      "ExitWorktree",
      "TaskCreate",
      "TaskUpdate",
      "TaskGet",
      "TaskList",
      "TaskStop",
      "DesignSync",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "ReadMcpResourceDirTool",
      "SearchMcpRegistry",
      "ListConnectors",
      "SuggestConnectors",
      "ListSkills",
      "SearchSkills",
      "ListPlugins",
      "SearchPlugins",
      "SuggestPluginInstall",
      "SuggestSkills",
      "ReportFindings",
      "ShowOnboardingRolePicker",
      "mcp__claude-code-remote",
      "mcp__ccd_session",
      "mcp__github",
      "mcp__Claude_Docs",
      "mcp__Gmail",
      "mcp__Google_Drive",
      "mcp__Google_Calendar",
      "mcp__Notion",
      "mcp__Vercel",
      "mcp__Canva",
      "mcp__Netlify",
      "mcp__remote-devices",
      "mcp__claude-in-chrome",
      "mcp__Claude_Browser",
      "mcp__computer-use",
      "mcp__claude_ai_*",
      "mcp__plugin_*",
      "mcp__research-collect"
    ]
  },
  "allowedMcpServers": [
    {
      "serverName": "research-drafter"
    }
  ],
  "enabledPlugins": {
    "savage-unboxed-content-engine@synced": false
  },
  "enableArtifact": false,
  "crossSessionInbound": "refuse",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/allow-only.mjs"
            ],
            "onFailure": "block",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
